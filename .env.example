# Copy this file to .env.local and fill in real values.
# Every variable exposed to client code MUST be prefixed with VITE_ and is
# therefore public once built - never put server-only secrets here.

# --- Firebase project configuration (Project settings > General > Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Region your Cloud Functions are deployed to
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# --- Google Maps (church location picker / routing) ---
VITE_GOOGLE_MAPS_API_KEY=

# --- Feature flags (must be exactly "true" to enable) ---
VITE_FEATURE_LIVE_MEETINGS=false
VITE_FEATURE_PAYMENTS=false

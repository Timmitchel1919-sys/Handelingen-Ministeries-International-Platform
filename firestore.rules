rules_version = '2';

// ---------------------------------------------------------------------------
// Handelingen Ministries International - Firestore security baseline
// (Layer 1: Identity, Authentication & Church Context).
//
// These rules are the actual authorization boundary. The client-side
// `can()`/RequirePermission checks (see src/lib/authorization.ts,
// src/app/routes/guards/) only control what the UI *shows* - a user who
// bypasses the UI entirely and talks to Firestore directly must still be
// stopped here. Nothing below ever evaluates `allow read, write: if true`.
//
// Known bootstrap limitation: role escalation from "member" to any
// leadership/admin role, and church document writes, are gated on the
// ACTING user's own already-stored `role` field (a standard Firestore RBAC
// pattern that needs no Cloud Functions). This has a bootstrapping
// problem - nothing in this app can create the very first church_admin/
// super_admin, since that requires an existing admin to already exist.
// The first admin of a new deployment must be set out-of-band (Firebase
// console, or a one-off Admin SDK script) before this rule set is useful
// for role management. A later layer should replace the self-referential
// get() calls here with Firebase Auth custom claims set by a trusted
// Cloud Function, which removes this limitation.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function ownProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveSelf() {
      return ownProfileExists() && ownProfile().accountStatus == 'active';
    }

    function isSuperAdmin() {
      return isActiveSelf() && ownProfile().role == 'super_admin';
    }

    function isChurchAdmin(churchId) {
      return isActiveSelf()
        && (ownProfile().role == 'church_admin' || ownProfile().role == 'church_pastor')
        && ownProfile().churchId == churchId;
    }

    function isChurchStaff(churchId) {
      return isSuperAdmin() || isChurchAdmin(churchId);
    }

    function unchangedExcept(doc, allowedKeys) {
      return request.resource.data.diff(doc).affectedKeys().hasOnly(allowedKeys);
    }

    // ----- churches/{churchId} ---------------------------------------------
    // Public read of active churches only - the "choose your church" step
    // (SelectChurchPage) runs before the visitor has an account. A church
    // being inactive isn't just a UI filter (Layer 1 rule).
    match /churches/{churchId} {
      allow get, list: if resource.data.status == 'active' || isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isChurchAdmin(churchId);
      allow delete: if isSuperAdmin();
    }

    // ----- users/{userId} ----------------------------------------------------
    match /users/{userId} {
      // A user reads their own profile; church staff read profiles within
      // their own church; a super admin reads any profile. Tenant
      // isolation: a church_admin can never read another church's users.
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isChurchAdmin(resource.data.churchId)
      );
      // `list` rules are evaluated per returned document, which only works
      // when the query itself filters on the same field (Firestore can't
      // otherwise verify the rule without reading unconstrained data) - so
      // any church-scoped user listing must query with
      // where('churchId', '==', <id>), matched here via resource.data.
      allow list: if isSuperAdmin() || isChurchAdmin(resource.data.churchId);

      // Account creation: only as yourself, and only with the safe
      // defaults (member / pending) - a client can never request a
      // privileged role or a pre-activated account for itself. `churchId`
      // must reference a church document that exists and is active.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.churchId is string
        && exists(/databases/$(database)/documents/churches/$(request.resource.data.churchId))
        && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)).data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Three, and only three, ways an existing profile can be updated:
      allow update: if isSignedIn() && (
        // (a) the owner updates their own non-sensitive display fields.
        (request.auth.uid == userId
          && unchangedExcept(resource.data, ['displayName', 'photoURL', 'updatedAt'])) ||

        // (b) the one client-initiated status transition: pending -> active,
        // gated on Firebase's own (non-client-controlled) email_verified
        // token claim, never on anything the client asserts about itself.
        (request.auth.uid == userId
          && hasVerifiedEmail()
          && resource.data.accountStatus == 'pending'
          && request.resource.data.accountStatus == 'active'
          && unchangedExcept(resource.data, ['accountStatus', 'updatedAt'])) ||

        // (c) church staff manage role/status for members of their own
        // church only; a super admin may do so for any church. Moving a
        // user to a different church is not permitted through this path.
        (isChurchStaff(resource.data.churchId)
          && request.resource.data.churchId == resource.data.churchId
          && unchangedExcept(resource.data, ['role', 'accountStatus', 'updatedAt']))
      );

      // No client-initiated deletes - account removal is an administrative
      // operation reserved for a later, backend-enforced flow.
      allow delete: if false;
    }

    // ----- auditLogs/{id} ----------------------------------------------------
    // Append-only: anyone signed in may log an event about their own
    // action; only administrators may read the trail, scoped to their own
    // church (a super admin sees everything). Never editable or deletable.
    match /auditLogs/{logId} {
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow get, list: if isSuperAdmin() || isChurchAdmin(resource.data.churchId);
      allow update, delete: if false;
    }

    // Deny everything else by default (no catch-all allow anywhere above).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

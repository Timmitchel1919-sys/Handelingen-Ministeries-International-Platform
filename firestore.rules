rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().accountStatus == 'active';
    }
    function superAdmin() { return active() && profile().role == 'super_admin'; }
    function churchAdmin(churchId) {
      return active() && profile().churchId == churchId
        && profile().role in ['church_admin', 'church_pastor'];
    }
    function sameChurch(churchId) { return active() && profile().churchId == churchId; }
    function staff(churchId) { return superAdmin() || churchAdmin(churchId); }
    function validProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'accountStatus', 'churchId', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'accountStatus', 'churchId', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && data.churchId is string && data.churchId.size() > 0
        && data.role in ['member', 'leader', 'ministry_leader', 'church_admin', 'church_pastor', 'super_admin']
        && data.accountStatus in ['pending', 'active', 'suspended', 'disabled']
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Public directory documents must contain public information only.
    match /churches/{churchId} {
      allow read: if resource.data.status == 'active' || staff(churchId)
        || (signedIn() && profile().churchId == churchId);
      allow create: if superAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['active', 'inactive', 'pending']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if staff(churchId)
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.status in ['active', 'inactive', 'pending']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if superAdmin();
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || staff(resource.data.churchId));
      allow list: if staff(resource.data.churchId);
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/churches/$(request.resource.data.churchId)).data.status == 'active';
      allow update: if signedIn() && validProfile(request.resource.data) && (
        (request.auth.uid == uid && changedOnly(['displayName', 'photoURL', 'updatedAt']))
        || (request.auth.uid == uid && verified()
          && resource.data.accountStatus == 'pending' && request.resource.data.accountStatus == 'active'
          && changedOnly(['accountStatus', 'updatedAt']))
        || (request.auth.uid != uid && changedOnly(['role', 'accountStatus', 'updatedAt'])
          && (superAdmin() || (churchAdmin(resource.data.churchId)
            && resource.data.role in ['member', 'leader', 'ministry_leader']
            && request.resource.data.role in ['member', 'leader', 'ministry_leader'])))
      );
      allow delete: if false;
    }
    match /memberRegistrations/{registrationId} {
      allow create: if signedIn() 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted', 'email_verification_pending']
        && request.resource.data.keys().hasAll(['uid', 'churchId', 'status', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt', 'decisionReason']));
      
      allow read: if signedIn() && (
        request.auth.uid == resource.data.uid 
        || staff(resource.data.churchId)
      );
      
      allow update: if signedIn() && (
        // Member updating their own registration
        (request.auth.uid == resource.data.uid 
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('reviewedBy', null) == resource.data.get('reviewedBy', null)
          && request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null)
          && request.resource.data.get('decisionReason', null) == resource.data.get('decisionReason', null)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.churchId == resource.data.churchId)
        || 
        // Admin updating status
        (staff(resource.data.churchId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.churchId == resource.data.churchId)
      );
      
      allow delete: if false;
    }
    
    // Existing member repository is read-only. Intake writes require the next layer.
    match /members/{memberId} {
      allow read: if staff(resource.data.churchId)
        || (sameChurch(resource.data.churchId)
          && (resource.data.userId == request.auth.uid || profile().role in ['leader', 'ministry_leader']));
      allow create: if staff(request.resource.data.churchId);
      allow update: if staff(resource.data.churchId) && request.resource.data.churchId == resource.data.churchId;
      allow delete: if superAdmin();
    }
    // Client events are untrusted activity reports, never authoritative admin audit records.
    match /auditLogs/{id} {
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == profile().role
        && request.resource.data.churchId == profile().churchId
        && request.resource.data.action in [
          'sign-up', 'sign-in', 'sign-out', 
          'registration-approved', 'registration-rejected', 'registration-review-started',
          'member-created', 'member-updated'
        ]
        && request.resource.data.createdAt == request.time;
      allow read: if staff(resource.data.churchId);
      allow update, delete: if false;
    }
    match /ministries/{id} {
      allow read: if superAdmin() || sameChurch(resource.data.churchId);
      allow create: if superAdmin() || churchAdmin(request.resource.data.churchId);
      allow update: if superAdmin() || churchAdmin(resource.data.churchId);
      allow delete: if superAdmin();
    }
    match /departments/{id} {
      allow read: if superAdmin() || sameChurch(resource.data.churchId);
      allow create: if superAdmin() || churchAdmin(request.resource.data.churchId);
      allow update: if superAdmin() || churchAdmin(resource.data.churchId);
      allow delete: if superAdmin();
    }
    match /teams/{id} {
      allow read: if superAdmin() || sameChurch(resource.data.churchId);
      allow create: if superAdmin() || churchAdmin(request.resource.data.churchId);
      allow update: if superAdmin() || churchAdmin(resource.data.churchId);
      allow delete: if superAdmin();
    }
    match /organizationMemberships/{id} {
      allow read: if superAdmin() || sameChurch(resource.data.churchId);
      allow create: if superAdmin() || churchAdmin(request.resource.data.churchId);
      allow update: if superAdmin() || churchAdmin(resource.data.churchId);
      allow delete: if superAdmin();
    }
    match /leadershipAssignments/{id} {
      allow read: if superAdmin() || sameChurch(resource.data.churchId);
      allow create: if superAdmin() || churchAdmin(request.resource.data.churchId);
      allow update: if superAdmin() || churchAdmin(resource.data.churchId);
      allow delete: if superAdmin();
    }
    match /events/{id} {
      allow read: if sameChurch(resource.data.churchId);
      allow create: if staff(request.resource.data.churchId);
      allow update, delete: if staff(resource.data.churchId);
    }
    match /eventRegistrations/{id} {
      allow read, update, delete: if sameChurch(resource.data.churchId) && (staff(resource.data.churchId) || resource.data.memberId == request.auth.uid);
      allow create: if sameChurch(request.resource.data.churchId) && (staff(request.resource.data.churchId) || request.resource.data.memberId == request.auth.uid);
    }
    match /attendanceRecords/{id} {
      allow read, update, delete: if sameChurch(resource.data.churchId) && staff(resource.data.churchId);
      allow create: if sameChurch(request.resource.data.churchId) && staff(request.resource.data.churchId);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
